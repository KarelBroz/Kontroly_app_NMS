generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uživatel appky. Zatím bez rolí — všichni přihlášení mají stejná práva.
// Připraveno na přidání `role` polem bez velké přestavby.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  importBatches       ImportBatch[]
  passwordResetTokens PasswordResetToken[]
  bugReports          BugReport[]
  reviewedFindings    Finding[]

  @@map("users")
}

// Token pro obnovení hesla (odkaz zaslaný e-mailem). Ukládá se jen hash
// tokenu, nikdy syrová hodnota — ta jde jen do e-mailového odkazu.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Rozpracovaná registrace, dokud si uživatel neověří e-mail 6místným kódem.
// User se založí, teprve až kód sedí — tím se ověří, že @nms.eu adresu
// opravdu vlastní (jinak by šlo napsat libovolnou vymyšlenou adresu).
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("pending_registrations")
}

// Ručně (v appce, na /users) předem povolené e-maily — kdo je na seznamu,
// založí si účet rovnou bez ověřovacího kódu (identitu v tomhle případě
// ověřuje člověk, co adresu přidal, ne appka přes e-mail). Zůstává jako
// rychlá cesta i po zprovoznění e-mailů, ne jen dočasná náhrada.
model AllowedRegistrationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@map("allowed_registration_emails")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  client      String
  description String?

  // Kód projektu ve formátu např. CZ26222 — první dvě číslice po písmenech
  // jsou rok (2026 -> "26"). Musí odpovídat názvu/kódu projektu v Intranetu.
  // Kontrola aktuálnosti roku je ruční, viz src/lib/projectCode.ts.
  code String? @unique

  // Kód projektu v systému Navigátor — jiné/nezávislé číslování než Intranet,
  // bez pevného formátu, žádná kontrola aktuálnosti.
  navigatorCode String?

  projectManager String?
  accountManager String?

  // Logo firmy — uložené přímo jako data URL (base64), zobrazuje se jako
  // ikona v dlaždici projektu. Bez dalšího souborového úložiště (viz
  // src/lib/logo.ts) — jednoduché a stačí pro malá loga; při potřebě
  // větších souborů časem přejít na Vercel Blob/S3.
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waves             Wave[]
  scenarioTemplates ScenarioTemplate[]

  @@map("projects")
}

// Šablona scénáře patřící projektu (např. "Cestovní pojištění 2026",
// "Povinné ručení 2026"). Ve vlně se z dostupných šablon projektu vybere
// 1..N, čímž vzniknou konkrétní Scenario záznamy pro danou vlnu.
model ScenarioTemplate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios Scenario[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("scenario_templates")
}

model Wave {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String

  // nepovinné, jen pro snazší hledání/filtrování vln; terén může běžet
  // napříč víc měsíci, proto pole (hodnoty 1-12)
  year   Int?
  months Int[] @default([])

  // volné nastavení vlny
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios     Scenario[]
  visits        Visit[]
  importBatches ImportBatch[]

  @@map("waves")
}

// Konkrétní scénář v rámci vlny — instance ScenarioTemplate s vlastním
// časovým oknem terénu a vlastními pravidly kontroly. Vlna jich může mít
// víc zároveň.
model Scenario {
  id                 String           @id @default(cuid())
  waveId             String
  wave               Wave             @relation(fields: [waveId], references: [id], onDelete: Cascade)
  scenarioTemplateId String
  scenarioTemplate   ScenarioTemplate @relation(fields: [scenarioTemplateId], references: [id])

  // strukturovaná pole scénáře (jen windowStart/windowEnd = Start/Konec
  // terénu) — JSON kvůli snadné rozšiřitelnosti do budoucna
  data Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules         Rule[]
  visits        Visit[]
  importBatches ImportBatch[]

  @@unique([waveId, scenarioTemplateId])
  @@index([scenarioTemplateId])
  @@map("scenarios")
}

// Jeden nahraný soubor dat. Patří vlně A konkrétnímu scénáři (při importu
// se scénář vybírá ručně — všechny řádky v souboru se týkají jednoho scénáře).
model ImportBatch {
  id            String   @id @default(cuid())
  waveId        String
  wave          Wave     @relation(fields: [waveId], references: [id], onDelete: Cascade)
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id])
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  fileName      String
  rowsTotal     Int      @default(0)
  rowsNew       Int      @default(0)
  rowsSkipped   Int      @default(0)
  rowsRechecked Int      @default(0)
  createdAt     DateTime @default(now())

  visits Visit[]

  @@index([waveId])
  @@index([scenarioId])
  @@map("import_batches")
}

// Návštěva = jeden vyplněný report jednoho mystery shoppera = jeden řádek importu.
// Patří konkrétnímu scénáři (podle scénáře vybraného při importu) — tím se
// určí, jaká pravidla se nad ní spouští.
model Visit {
  id         String   @id @default(cuid())
  waveId     String
  wave       Wave     @relation(fields: [waveId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  // stabilní klíč napříč opakovanými importy
  inspectionId String

  // hash obsahu importovaných polí — pro detekci změny při re-importu
  contentHash String

  // naparsovaná data odpovědí (klíč = název sloupce z importu)
  data Json

  lastImportBatchId String?
  lastImportBatch   ImportBatch? @relation(fields: [lastImportBatchId], references: [id])

  // externí kontrolor, co tuhle návštěvu ručně prošel PŘED importem do appky
  // (sloupce Control: Firstname/Surname/Email v datech) — NENÍ uživatel
  // appky, viz model Reviewer. Nezaměňovat s Finding.reviewedBy (kolega
  // z NMS, co v appce potvrdil/zamítl konkrétní nález).
  reviewerId String?
  reviewer   Reviewer? @relation(fields: [reviewerId], references: [id])

  // "zmrazený" počet nálezů hned po (pře)importu — výkon externího
  // kontrolora v okamžiku, kdy data přišla. Pozdější ruční vyřešení nálezů
  // v appce (Finding.status) už tohle zpětně nemění — viz
  // src/lib/stats/reviewerStats.ts. Null = zatím nespočítáno (starší
  // návštěva odsud, nebo se kontrolor dohledal jen zpětně bez re-kontroly).
  initialFindingsCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings Finding[]

  @@unique([waveId, inspectionId])
  @@index([scenarioId])
  @@index([reviewerId])
  @@index([lastImportBatchId])
  @@map("visits")
}

// Externí kontrolor mystery shoppingu — ručně prochází návštěvy před jejich
// zveřejněním/importem do appky. Identifikuje se e-mailem ze sloupců
// "Control: Firstname/Surname/Email" v importu — při prvním výskytu emailu
// se profil založí automaticky (viz src/lib/import/importVisits.ts). Nemá
// vlastní přihlášení do appky, jen záznam v "Databázi kontrolorů".
model Reviewer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]

  @@map("reviewers")
}

enum RuleType {
  REQUIRED // Povinné pole — otázka (Kód otázky) nesmí být prázdná
  ALLOWED_VALUES // Povolené hodnoty — odpověď musí být jedna ze zadaného seznamu
  NUMERIC_RANGE // Číselný rozsah — odpověď musí být číslo v zadaném rozsahu
  // Podmíněně povinné — pokud "Kód otázky" NENÍ roven zadané hodnotě (např.
  // odpověď není "Ano"), musí být vyplněná navazující doplňující otázka
  // (config.detailQuestionCode) — typicky "vysvětlete, co se stalo".
  CONDITIONAL_REQUIRED
  // Povolený seznam artiklů — odpověď musí odpovídat jedné z položek
  // seznamu, tolerantně (velikost písmen, slovosled, drobné překlepy).
  PRODUCT_ALLOWLIST
  // Prahová shoda — číselná otázka (config.questionCode) porovnaná s prahem
  // (config.threshold) musí odpovídat hodnotě navazující ano/ne otázky
  // (config.booleanQuestionCode): "nad prahem" -> config.valueAbove,
  // "na prahu nebo pod ním" -> config.valueAtOrBelow. Např. "průměrná
  // fronta 3,1+ zákazníků" (nad 3) musí mít u "byla fronta max. 3?"
  // odpověď "Ne".
  NUMERIC_THRESHOLD_CONSISTENCY
}

// Pravidlo kontroly navázané na konkrétní scénář (ne na celou vlnu) —
// každý scénář má svoje vlastní pravidla. Nové pravidla lze při založení
// scénáře nakopírovat z jiného existujícího scénáře (viz copyRulesFromScenario
// v src/app/(app)/projects/[projectId]/waves/[waveId]/actions.ts).
model Rule {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  type       RuleType
  name       String
  config     Json
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings Finding[]

  @@index([scenarioId])
  @@map("rules")
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

// Automatické kontroly, které běží vždy a všude (napříč všemi projekty/vlnami),
// bez ohledu na ručně nastavená Rule — viz src/lib/rules/runRules.ts.
enum SystemCheckType {
  REAL_DATE_WINDOW // datum návštěvy (sloupec RealDate) mimo Start/Konec terénu scénáře
  GRAMMAR // možný překlep/pravopisná chyba v odpovědi (offline heuristika)
}

model Finding {
  id      String @id @default(cuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  // buď patří ručně nastavenému pravidlu (ruleId), nebo je to automatická
  // systémová kontrola (systemCheck) — vždy je nastavené právě jedno z nich.
  ruleId      String?
  rule        Rule?            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  systemCheck SystemCheckType?

  severity FindingSeverity @default(MEDIUM)
  status   FindingStatus   @default(OPEN)
  message  String
  details  Json?

  // kdo naposledy ručně nastavil stav (přes tlačítka chyba/opraveno) — pro
  // zobrazení iniciál kontrolora vedle nálezu, viz src/app/(app)/.../page.tsx
  reviewedById String?
  reviewedBy   User?   @relation(fields: [reviewedById], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([visitId])
  @@index([ruleId])
  @@index([status])
  @@index([reviewedById, resolvedAt])
  @@map("findings")
}

enum BugReportStatus {
  PENDING // čeká na vyhodnocení
  RESOLVED // vyřešeno
  REJECTED // zamítnuto
}

// Nahlášení chyby uživatelem přímo ze stránky appky, kde na ni narazil
// (kulatá vlaječka vpravo dole, viz src/components/bugreport/BugReportButton.tsx).
model BugReport {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // cesta (pathname), na které uživatel chybu nahlásil — proklikem se na
  // ni admin dostane rovnou z přehledu v "Sběr chyb".
  pageUrl String
  message String

  status BugReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bug_reports")
}
