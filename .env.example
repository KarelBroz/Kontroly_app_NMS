# PostgreSQL connection string (Neon) — použij "pooled" connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js)
# POZOR: na Vercelu tuhle proměnnou buď nastav na skutečnou doménu appky, nebo ji
# vůbec nepřidávej (prázdná hodnota "" shodí build s "Invalid URL" chybou).
NEXTAUTH_URL="http://localhost:3000"
# vygeneruj přes: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Veřejná base URL appky — appka nemá natvrdo zadanou doménu, vše jde přes tuhle proměnnou
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Odesílání e-mailů (zapomenuté heslo) přes Resend — https://resend.com (zdarma do 100 e-mailů/den)
RESEND_API_KEY=""
# Než si ověříš vlastní doménu (nms.eu) v Resendu, nech výchozí testovací adresu:
MAIL_FROM="Kontroly MS <onboarding@resend.dev>"
