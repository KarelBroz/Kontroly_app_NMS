# PostgreSQL connection string (Neon) — použij "pooled" connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
# vygeneruj přes: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Veřejná base URL appky — appka nemá natvrdo zadanou doménu, vše jde přes tuhle proměnnou
NEXT_PUBLIC_APP_URL="http://localhost:3000"
